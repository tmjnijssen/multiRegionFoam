FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      cp;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 -1 0 0 0];

internalField   uniform 1005;

boundaryField
{
    fluid_to_solid
    {
        type            zeroGradient;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 1005;
    }
    outlet
    {
        type            zeroGradient;
    }
    defaultFaces
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

