FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          transportProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel Newtonian;
// Density
rho             rho [1 -3 0 0 0 0 0] 1;

// specific volume (1/rho)
v             v [-1 3 0 0 0 0 0] 1;

// Vicosity
mu              mu [ 1 -1 -1 0 0 0 0 ] 1.25e-5;
nu              nu [ 0 2 -1 0 0 0 0 ] 1.25e-5;
// Specific heat - Dimensions: J/kg-K
cp              cp  [0 2 -2 -1 0 0 0] 2030;


// Thermal conductivity - Dimensions: W/m-K
k            	k   [1 1 -3 -1 0 0 0] 0.025;

