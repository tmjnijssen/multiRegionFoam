FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 310;

boundaryField
{
    space
    {
        type            fixedValue;
        value           $internalField;
    }
    interfaceShadow
    {
        type                    regionCoupledTemperatureJump;
        interfaceType           (heatTransferInterface);
        k                       "k";

        //accType               fixed;
        //relax                   0.1;
        
         accType               aitken;
         relax                   0.8;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     fluidB;
        neighbourPatchName      interface;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
}


