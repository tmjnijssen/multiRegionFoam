FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      regionInterfaceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

partitionedCoupledPatches
(
    fluidAfluidB
    {
        interfaceType (capillaryInterface heatTransferInterface massTransferInterface);

        coupledPatchPair
        (
            (fluidA interface)
            (fluidB interfaceShadow)
        );

        coupledFields
        (
            pUPimple
            T
        );

        capillaryInterfaceCoeffs
        {
            sigma       sigma [ 1 0 -2 0 0 0 0 ] 0.07232;
        }
        
        heatTransferInterfaceCoeffs
        {
            // Jump coefficient
            K               K [ 0 0 0 0 0 0 0 ] 1;
        }

        massTransferInterfaceCoeffs
        {
            TSat       TSat [ 1 0 0 0 0 0 0 ] 300;
            mDots       mDots [ 1 0 -1 0 0 0 0 ] 0;
            hlv            hlv [ 1 0 0 0 0 0 0 ] 329.4e3;
        }
    }
);

monolithicCoupledPatches
();

curvatureCorrectedSurfacePatches 0();

interpolatorUpdateFrequency 0;

interfaceTransferMethod directMap;

directMapCoeffs
{}

GGICoeffs
{}

