FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.01;

vertices
(
    (0 0 0) //0
    (1.5 0 0) //1
    (1.5 .5 0) //2
    (0 .5 0) //3

    (0 0 2) //4
    (1.5 0 2) //5
    (1.5 .5 2) //6
    (0 .5 2) //7

);

blocks
(
    hex (0 1 2 3 4 5 6 7) (200 1 100) simpleGrading (1 1 0.15)
);

boundary
(
    bottom
    {
        type patch;
        faces
        (
            (0 1 2 3)
        );
    }
    
    symmetryPlanes
    {
        type symmetryPlane;
        faces
        (
            (6 2 1 5)
            (0 3 7 4)
        );
    }

    interface
    {
        type patch;
        faces
        (
            (4 7 6 5)
        );
    }
    frontAndBackPlanes
    {
        type empty;
        faces
        (
            (7 3 2 6)
            (0 1 5 4)
        );
    }

);

