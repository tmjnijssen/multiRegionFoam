FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    interface
    {
        type                    regionCoupledPhaseChangeHeatFlux;
        interfaceType           (massTransferInterface);
        k                       "k";
        neighbourRegionName     fluidB;
        neighbourPatchName      interfaceShadow;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    bottom
    {
        type            fixedValue;
        value           $internalField;
    }
    walls
    {
        type            zeroGradient;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
    symmetryPlanes
    {
        type            symmetryPlane;
    }
}

