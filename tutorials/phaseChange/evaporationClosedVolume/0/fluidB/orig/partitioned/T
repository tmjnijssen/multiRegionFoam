FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    interfaceShadow
    {
        type                    regionCoupledTemperatureJump;
        interfaceType           (heatTransferInterface);
        k                       "k";

        // accType               fixed;
        // relax                   1.0;

        accType               aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     fluidA;
        neighbourPatchName      interface;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    walls
    {
        type            zeroGradient;
    }
    right
    {
        type            zeroGradient;
    }
    top
    {
        type            fixedValue;
        value           uniform 310;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
    symmetryPlanes
    {
        type            symmetryPlane;
    }
}

