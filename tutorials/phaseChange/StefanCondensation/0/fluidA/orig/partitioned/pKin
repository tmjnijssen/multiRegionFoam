FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    walls
    {
        type            zeroGradient;
        value           uniform 0;
    }
    bottom
    {
        type            zeroGradient;
        value           uniform 0;
    }
    interface
    {
        type                    regionCoupledKineticPressureValue;
        k                       "v";
        neighbourRegionName     fluidB;
        neighbourPatchName      interfaceShadow;
        neighbourFieldName      pKin;
        interfaceType           (capillaryInterface);
        secondOrder             true;
        nonOrthCorr             false;
        value                   uniform 0;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
    symmetryPlanes
    {
        type            symmetryPlane;
    }
}


