FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.01;

vertices
(
    (0 0 0.001) //0
    (1 0 0.001) //1
    (1 .5 0.001) //2
    (0 .5 0.001) //3

    (0 0 10) //4
    (1 0 10) //5
    (1 .5 10) //6
    (0 .5 10) //7

);

blocks
(
    hex (0 1 2 3 4 5 6 7) (4 1 400) simpleGrading (1 1 12)
);

boundary
(
    interfaceShadow
    {
        type wall;
        faces
        (
            (0 1 2 3)
        );
    }
    
    walls
    {
        type patch;
        faces
        (
            (6 2 1 5)
            (0 3 7 4)
        );
    }

    top
    {
        type patch;
        faces
        (
            (4 7 6 5)
        );
    }
    frontAndBackPlanes
    {
        type empty;
        faces
        (
            (7 3 2 6)
            (0 1 5 4)
        );
    }

);

