FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      coupledSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

regions
(
    ( fluidA (pimpleFluid transportTemperature) )
    ( fluidB (pimpleFluid transportTemperature) )
);

// Assembles a super-mesh
superMeshRegions
();

DNA
{
    pUPimple
    {
        maxCoupleIter 20;

        residualControl
        {
            U
            {
                maxJumpRes 1e-6;
                outputJumpResField no;
                maxFluxRes 1e-5;
                outputFluxResField no;
            }

            pKin
            {
                maxJumpRes 1e-6;
                outputJumpResField no;
                maxFluxRes 1e-5;
                outputFluxResField no;
            }
        }
    }
    
    T
    {
        maxCoupleIter 20;

        residualControl
        {
            maxJumpRes 1e-08;
            outputJumpResField no;
            maxFluxRes 1e-08;
            outputFluxResField no;
        }
    }
}

