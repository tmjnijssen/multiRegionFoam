FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          transportProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
transportModel Newtonian;

// Density
rho             rho [1 -3 0 0 0 0 0] 550.6;

// specific volume (1/rho)
v             v [-1 3 0 0 0 0 0] 1.0e-3;

// Viscosity
mu              mu [ 1 -1 -1 0 0 0 0 ] 45699.8e-8;
nu              nu [ 0 2 -1 0 0 0 0 ] 83e-8;

// Specific heat - Dimensions: J/kg-K
cp              cp  [0 2 -2 -1 0 0 0] 2446.0;

// Thermal conductivity - Dimensions: W/m-K
k               k   [1 1 -3 -1 0 0 0] 0.0893;

