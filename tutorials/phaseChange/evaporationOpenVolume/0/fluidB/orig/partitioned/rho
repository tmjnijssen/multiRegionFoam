FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          rho;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 1.1;

boundaryField
{
    interfaceShadow
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
    right
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
}

