FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default			bdf2;
}

gradSchemes
{
    default         		leastSquares;
}

divSchemes
{
    default                 Gauss linear;
    div(phi,U)              Gauss vanLeer;
    div(phi,T)              Gauss vanLeer;
    div(phi,CO2)              Gauss vanLeer;
    div(phi,H2O)              Gauss vanLeer;
}

laplacianSchemes
{
    default         		Gauss linear corrected;
}

interpolationSchemes
{
    default         		linear;
}

snGradSchemes
{
    default         		corrected;
}

fluxRequired
{
    default         no;
    T;
    p;
    pcorr;
    CO2;
    H2O;
}

