FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiPos;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 4.125;

boundaryField
{
    posTab
    {
        type            fixedGradient;
        gradient        uniform 17.5e-03; //3C
    }
    negTab
    {
        type            zeroGradient;
    }
    cylinder
    {
        type            zeroGradient;
    }
}

