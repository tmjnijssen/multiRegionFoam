FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 295.15;

boundaryField
{
    airbulk
    {
        type            fixedValue;
        value           $internalField;
    }

    ground 
    {
        type            zeroGradient;
    }

    cell1_toPosTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     cell1;
        neighbourPatchName      toPosTab;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    cell1_toNegTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     cell1;
        neighbourPatchName      toNegTab;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    cell1_bottom
    {
        type            zeroGradient;
    }
    cell1_housing
    {
        type                    regionCoupledTemperatureJump;
        interfaceType           heatTransferInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     cell1;
        neighbourPatchName      housing;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }

    cell2_toPosTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     cell2;
        neighbourPatchName      toPosTab;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    cell2_toNegTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     cell2;
        neighbourPatchName      toNegTab;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    cell2_bottom
    {
        type            zeroGradient;
    }
    cell2_housing
    {
        type                    regionCoupledTemperatureJump;
        interfaceType           heatTransferInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     cell2;
        neighbourPatchName      housing;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
}

