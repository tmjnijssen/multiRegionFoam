FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          transportProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// volume fraction electrolyte phase - Dimensions: -
epsE             epsE [0 0 0 0 0 0 0] 0.485;

// volume fraction filler - Dimensions: -
epsF             epsF [0 0 0 0 0 0 0] 0.0326;

// bruggeman coefficient - Dimensions: -
brugg            brugg [0 0 0 0 0 0 0] 4;

// particle radius - Dimensions: m
r                r [0 1 0 0 0 0 0] 2.0e-6;

// maximum Li surface concentration - Dimensions: mol/m³
cSMax            cSMax [0 -3 0 0 1 0 0] 30555;

// minimum Li surface concentration - Dimensions: mol/m³
cSMin            cSMin [0 -3 0 0 1 0 0] 100;

// electrolyte diffusion coefficient - Dimensions: m²/s
DE               DE [0 2 -1 0 0 0 0] 7.5e-10;

// Li diffusivity in solid phase - Dimensions: m²/s
DS          	 DS [0 2 -1 0 0 0 0] 3.9e-14;

// solid phase conductivity - Dimensions: S/m
sigmaInt            sigmaInt [-1 -3 3 0 0 2 0] 100;

// specific particle radius surface - Dimension m²/m³
spArea           spArea [0 -1 0 0 0 0 0] 723600;

// density - Dimension kg/m³
rho              rho [1 -3 0 0 0 0 0] 2500;

// specific heat - Dimension: J/(kg K)
cp               cp [0 2 -2 -1 0 0 0] 700;

// thermal conductivity - Dimension: W/(m K)
kT               kT [1 1 -3 -1 0 0 0] 1.7;

// energy barrier solid state diffusion - Dimension: J/mol
EADiff           EADiff [1 2 -2 0 -1 0 0] 5000;

