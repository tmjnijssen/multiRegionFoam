FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1e-6;

xA 88;
y 30;
z 10;

vertices
(

    (0 0 0)
    ($xA 0 0)
    ($xA $y 0)
    (0 $y 0)

    (0 0 $z)
    ($xA 0 $z)
    ($xA $y $z)
    (0 $y $z)

);


blocks
(
    hex (0 1 2 3 4 5 6 7) ($xA 1 1) simpleGrading (1 1 1) 
);


patches
(
    empty topAndBottom
    (
        (4 7 6 5)
        (0 3 2 1)
    )
    patch left
    (
        (0 4 7 3)
    )
    patch right
    (
        (2 6 5 1)
    )
    empty frontAndBack
    (
        (0 4 5 1)
        (3 7 6 2)
    )
);

