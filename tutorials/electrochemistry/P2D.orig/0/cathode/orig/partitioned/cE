FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          cE;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 1000;

boundaryField
{
    right
    {
        type                    zeroGradient;
    }
    left
    {
        type                    regionCoupledScalarFlux;
        interfaceType           defaultInterface;
        k			            "DE";
        
        neighbourRegionName     sep;
       	neighbourPatchName      right;
       	neighbourFieldName      faiE;
       	
	    secondOrder		        false;
	    nonOrthCorr		        false;
       	value                   $internalField;
    }
    topAndBottom
    {
        type                    empty;
    }
    frontAndBack
    {
        type                    empty;
    }

}

