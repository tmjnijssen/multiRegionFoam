FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiS;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 4.155;

boundaryField
{
    right
    {
        //BC for steady-state constant voltage, no charge/discharge
        type                    zeroGradient;
        
        //BC for charge/discharge with constant current density IApp
        //type					groovyBC;
        //variables				"IApp=-30;sigma=sigma;";
        //gradientExpression		"IApp/sigma";
        //fractionExpression		"( faiS > 0 ) ? 0 : 1";
        //value					$internalField;
        
        //BC for charge/discharge with given C-Rate CR
        //type					groovyBC;
        //varialbes				"CR=1;sigma=sigma;  ;"; //TO DO: Expression from Capacity/Electrolyte concentration/SoC over C-Rate to IApp
        //gradientExpression	"IApp/sigma";
        //fractionExpression	"( faiS > 0 ) ? 0 : 1";
        //value					$internalField;
        
    }
    left
    {
        type                    zeroGradient;
    }
    topAndBottom
    {
        type                    empty;
    }
    frontAndBack
    {
        type                    empty;
    }

}

