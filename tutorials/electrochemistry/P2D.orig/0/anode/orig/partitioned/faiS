FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiS;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0.0001;

boundaryField
{
    right
    {
        type                    zeroGradient;
    }
    left
    {
        type                    fixedValue;
        value                   $internalField;
    }
    topAndBottom
    {
        type                    empty;
    }
    frontAndBack
    {
        type                    empty;
    }

}

