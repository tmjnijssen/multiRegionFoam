FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    right
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "kT";

        //accType               fixed;
        //relax                   1.0;

         accType               aitken;
         relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     sep;
        neighbourPatchName      left;
        neighbourFieldName      T;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    left
    {
        type                    fixedValue;
        value                   $internalField;
    }
    topAndBottom
    {
        type                    empty;
    }
    frontAndBack
    {
        type                    empty;
    }

}

