FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default			backward;
}

gradSchemes
{
    default         cellMDLimited Gauss linear 1;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default                 Gauss linear corrected;
    laplacian(kappa,faiE)   Gauss linear corrected;
    laplacian(DE,cE)        Gauss linear corrected;
    laplacian(kT,T)        Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    faiE;
    cE;
    T;
}

