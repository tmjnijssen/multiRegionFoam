FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiNeg;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0.0;

boundaryField
{
    leftRight
    {
        type                    zeroGradient;
        
    }
    bottom
    {
        type                    fixedValue;
        value                   $internalField;
        
    }
    top
    {
        type                    regionCoupledScalarFlux;
        interfaceType           defaultInterface;
        k                       "sigmaNeg";
        
        neighbourRegionName     cell;
        neighbourPatchName      intNegativeTab;
        neighbourFieldName      faiNeg;
        
        secondOrder             true;
        nonOrthCorr             false;
        value                   $internalField;
    }
    frontAndBack
    {
        type                    zeroGradient;
    }

}

