FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.04;

boundaryField
{
    top
    {
        type            zeroGradient;
    }
    leftRight
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    intPositiveTab
    {
        type            zeroGradient;
    }
    intNegativeTab
    {
        type            zeroGradient;
    }
    
}

