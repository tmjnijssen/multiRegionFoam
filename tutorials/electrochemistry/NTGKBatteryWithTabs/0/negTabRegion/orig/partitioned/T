FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 295.15;

boundaryField
{
    top
    {
        type            zeroGradient;
    }
    left
    {
        type            zeroGradient;
    }
    right
    {
        type            zeroGradient;
    }
    toCell
    {
        type                    regionCoupledScalarFlux;
        interfaceType           (defaultInterface);
        k                       "k";
        neighbourRegionName     batteryRegion;
        neighbourPatchName      toNegTab;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    defaultFaces
    {
        type            empty;
    }
}

