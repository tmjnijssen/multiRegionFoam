{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          transportProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// Density - Dimensions: kg/m3
rho             rho [1 -3 0 0 0 0 0] 8933; // copper current collector

// Specific heat - Dimensions: J/kg-K
cp              cp  [0 2 -2 -1 0 0 0] 385; // copper current collector

// Thermal conductivity - Dimensions: W/m-K
k                   k [1 1 -3 -1 0 0 0] 398; // copper current collector

// electric conductivity negative cuurent collector - Dimensions: S/m
sigmaNeg            sigmaNeg [-1 -3 3 0 0 2 0] 59.6e6; // copper current collector
