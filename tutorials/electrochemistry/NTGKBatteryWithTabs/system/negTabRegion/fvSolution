solvers
{
    phiNeg
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
        minIter         2;
        maxIter         250;
    };

    T
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
        minIter         2;
        maxIter         250;
    };
}

