FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiNeg;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    toPosTab
    {
        type            zeroGradient;
    }
    toNegTab
    {
        type                    regionCoupledScalarFlux;
        interfaceType           defaultInterface;
        k                       "sigmaNeg";
        neighbourRegionName     negTabRegion;
        neighbourPatchName      toCell;
        neighbourFieldName      faiNeg;
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    top
    {
        type            zeroGradient;
    }
    left
    {
        type            zeroGradient;
    }
    right
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    defaultFaces
    {
        type            empty;
    }
}

