FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiNeg;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform 0;
    }
    left
    {
        type            zeroGradient;
    }
    right
    {
        type            zeroGradient;
    }
    toCell
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "sigmaNeg";
        neighbourRegionName     batteryRegion;
        neighbourPatchName      toNegTab;
        neighbourFieldName      faiNeg;
        accType                 aitken;
        relax                   0.1;
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    defaultFaces
    {
        type            empty;
    }
}

