FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 295.15;

boundaryField
{
    airbulk
    {
        type            fixedValue;
        value           $internalField;
    }

    ground 
    {
        type            zeroGradient;
    }

    cell_toPosTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     batteryRegion;
        neighbourPatchName      toPosTab;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    cell_toNegTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     batteryRegion;
        neighbourPatchName      toNegTab;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
    cell_bottom
    {
        type            zeroGradient;
    }
    cell_housing
    {
        type                    regionCoupledTemperatureJump;
        interfaceType           heatTransferInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   1.0;

        accType                 aitken;
        relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     batteryRegion;
        neighbourPatchName      housing;
        neighbourFieldName      T;
        secondOrder             false;
        nonOrthCorr             true;
        value                   $internalField;
    }
}

