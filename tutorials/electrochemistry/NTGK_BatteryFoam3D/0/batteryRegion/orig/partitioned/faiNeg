FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiNeg;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    toPosTab
    {
        type            zeroGradient;
    }
    toNegTab
    {
        type            fixedValue;
        value           uniform 0;
    }
    top
    {
        type            zeroGradient;
    }
    left
    {
        type            zeroGradient;
    }
    right
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            zeroGradient;
    }
}

