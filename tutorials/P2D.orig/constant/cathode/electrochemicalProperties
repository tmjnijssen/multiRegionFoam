FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          transportProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// electrode material model for ocv (choose anode: graphite, silicium - cathode: LFP, NCA, lionsimba)
electrodeMaterial   lionsimba;

// applied current - Dimensions: A/m² (positive for discharge - negative for charge)
IApp                IApp [0 -2 0 0 0 1 0] 0;

// anodic transfer coefficient - Diemnsions: -
alphaA              alphaA [0 0 0 0 0 0 0] 0.5;

// cathodic transfer coefficient - Diemnsions: -
alphaC              alphaC [0 0 0 0 0 0 0] 0.5;

// reaction rate constant - Dimensions: m^2.5 mol^-0.5 s^-1 
kRct                kRct [0 2.5 -1 0 -0.5 0 0] 2.334e-11;

// initial state of charge - Dimensions: - 
SoCInit             SoCInit [0 0 0 0 0 0 0] 1;

// transference number - Dimensions: -
tNo                 tNo [0 0 0 0 0 0 0] 0.364;

// activation energy barrier anode reaction - Dimensions J/mol
EARct               EARct [1 2 -2 0 -1 0 0] 5000;
 
// reference temperature - Dimension: K
TRef                TRef [0 0 0 1 0 0 0] 298.15;


