FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    rho
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
    }

    U
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }

    UFinal
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }

    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
    }

    pFinal
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
    }

    h
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }

    hFinal
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }

    R
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }

    k
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }

    epsilon
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }

    omega
    {
        solver          BiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
    }
}

PIMPLE
{
    nOuterCorrectors 5;
    nCorrectors     3;
    nNonOrthogonalCorrectors 2;
    momentumPredictor yes;
    pMin            pMin [ 1 -1 -2 0 0 0 0 ] 1000;
}

relaxationFactors
{
    U               0.7;
    UFinal          0.7;
    p               0.15;
    rho             0.025;
    h               0.5;
    hFinal          0.8;
    k               0.7;
    omega           0.7;
}


