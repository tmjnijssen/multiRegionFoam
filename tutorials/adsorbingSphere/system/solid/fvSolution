FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    R2NH
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    };

    R2NH2p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    };

    R2NHCO2m
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    };

    HCO3m
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    };
    
    CO2
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    }

    H2O
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    };   
    
    T
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    };

    Tcoupled
    {
        solver           BiCGStab;
        
        preconditioner      
        {                   
            preconditioner  Cholesky;
        }

        tolerance        1e-5;
        relTol           0;
    };
}

SIMPLE
{
    nNonOrthogonalCorrectors 3;

    residualControl
    {
        T               1e-7;
    }
}

PISO
{
    pRefPoint (0 0 0); 
    pRefValue 0;
}

PIMPLE
{
    // p-U coupling
    //nOuterCorrectors            3; // SIMPLEC loops, see constant/fvSolution
    nCorrectors                 2; // PISO loops
    nNonOrthogonalCorrectors    1;

    residualControl
    {
        p
        {
            relTol         0;
            tolerance      0;
        }

        U
        {
            relTol         0;
            tolerance      0;
        }
    }
}

relaxationFactors
{
	T	1.0;
}



