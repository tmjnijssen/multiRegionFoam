FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      R2NCO2m;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type                    zeroGradient;
        value                   $internalField;
    }
    
    outlet
    {
        type                    zeroGradient;
        value                   $internalField;
    }
    
    walls
    {
        type                    zeroGradient;
        value                   $internalField;
    }
}


