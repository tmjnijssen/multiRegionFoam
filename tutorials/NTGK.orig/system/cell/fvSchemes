FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default			Euler;
    ddt(fai)        steadyState;
}

gradSchemes
{
    default         cellMDLimited Gauss linear 1;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    default                 Gauss linear corrected;
    laplacian(sigma,fai)   Gauss linear corrected;
    laplacian(k,T)        Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    faiPos;
    faiNeg;
    T;
    //alpha;
    //cELE;
    //cNE;
    //cSEI;
    //tSEI;
}

