FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiPos;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 4.112;

boundaryField
{
    leftRight
    {
        type                    zeroGradient;
        
    }
    bottom
    {
        type                    regionCoupledScalarFlux;
        interfaceType           defaultInterface;
        k                       "sigmaPos";
        
        neighbourRegionName     cell;
        neighbourPatchName      intPositiveTab;
        neighbourFieldName      faiPos;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    top
    {
        type                    fixedGradient;
        gradient                uniform 10.0;

        //type                    fixedValue;
        //value                   uniform 3.1;
    }
    frontAndBack
    {
        type                    zeroGradient;
    }

}

