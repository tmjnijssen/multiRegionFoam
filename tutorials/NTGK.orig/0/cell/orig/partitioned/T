FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    top
    {
        type            fixedValue;
        value           $internalField;
    }
    leftRight
    {
        type            fixedValue;
        value           $internalField;
    }
    frontAndBack
    {
        type            fixedValue;
        value           $internalField;
    }
    bottom
    {
        type            fixedGradient;
        gradient        uniform 1000.0;

        //type            fixedValue;
        //value           $internalField;
    }
    intPositiveTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   0.001;

         accType               aitken;
         relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     positiveTab;
        neighbourPatchName      bottom;
        neighbourFieldName      T;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    intNegativeTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        //accType                 fixed;
        //relax                   0.001;

         accType               aitken;
         relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     negativeTab;
        neighbourPatchName      bottom;
        neighbourFieldName      T;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
}

