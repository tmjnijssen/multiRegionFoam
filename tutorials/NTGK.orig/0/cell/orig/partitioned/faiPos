FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          faiPos;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 4.12;

boundaryField
{
    top
    {
        type            zeroGradient;
    }
    leftRight
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    intPositiveTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "sigmaPos";

        //accType                 fixed;
        //relax                   0.001;

         accType               aitken;
         relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     positiveTab;
        neighbourPatchName      bottom;
        neighbourFieldName      faiPos;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    intNegativeTab
    {
        type            zeroGradient;
    }
}

