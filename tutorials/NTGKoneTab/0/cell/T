FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    /*top
    {
        type            zeroGradient;
    }*/
    leftRight
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            zeroGradient;
    }
    /*bottom
    {
        type            zeroGradient;
    }*/
    intPositiveTab
    {
        type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        accType                 fixed;
        relax                   0.01;

         //accType               aitken;
         //relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     positiveTab;
        neighbourPatchName      bottom;
        neighbourFieldName      T;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    intNegativeTab
    {
        type                    zeroGradient;


        /*type                    regionCoupledScalarJump;
        interfaceType           defaultInterface;
        k                       "k";

        accType                 fixed;
        relax                   0.01;

         //accType               aitken;
         //relax                   0.75;

        // accType               IQN-ILS;
        // relax                   0.75;
        // couplingReuse           0; //2;


        neighbourRegionName     negativeTab;
        neighbourPatchName      top;
        neighbourFieldName      T;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;*/
