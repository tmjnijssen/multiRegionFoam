FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    leftRight
    {
        type                    zeroGradient;
        
    }
    bottom
    {
        type                    zeroGradient;
    }
    top
    {
        type                    regionCoupledScalarFlux;
        interfaceType           defaultInterface;
        k                       "k";
        
        neighbourRegionName     cell;
        neighbourPatchName      intNegativeTab;
        neighbourFieldName      T;
        
        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    frontAndBack
    {
        type                    zeroGradient;
    }

}

