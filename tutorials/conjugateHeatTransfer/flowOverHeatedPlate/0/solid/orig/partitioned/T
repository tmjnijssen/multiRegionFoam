FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    object          T;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 0 1 0 0 0];

internalField   uniform 310;

boundaryField
{
    top
    {
        type                    regionCoupledHeatFlux;
        interfaceType           (heatTransferInterface);
        neighbourRegionName     fluid;
        neighbourPatchName      interface;
        neighbourFieldName      T;

        k                       "k";

        secondOrder             false;
        nonOrthCorr             false;
        value                   $internalField;
    }
    left
    {
        type            zeroGradient;
    }
    right
    {
        type            zeroGradient;
    }
    bottom
    {
        type            fixedValue;
        value           $internalField;
    }
    defaultFaces
    {
        type            empty;
    }
}

